#!/bin/sh
set -eu

if [ "$1" = configure ] && command -v flatpak >/dev/null 2>&1; then
    # Network failure must not leave dpkg half-configured. A later explicit
    # `flatpak remote-add` can complete this optional integration.
    timeout 30s flatpak remote-add --system --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 || true
fi

if [ "$1" = configure ] && command -v zsh >/dev/null 2>&1; then
    # Make Zsh the default for users created after this package is installed.
    if command -v useradd >/dev/null 2>&1; then
        useradd -D -s /usr/bin/zsh >/dev/null 2>&1 || true
    fi
    if [ -w /etc/adduser.conf ]; then
        if grep -q '^DSHELL=' /etc/adduser.conf 2>/dev/null; then
            sed -i 's|^DSHELL=.*|DSHELL=/usr/bin/zsh|' /etc/adduser.conf || true
        elif grep -q '^#DSHELL=' /etc/adduser.conf 2>/dev/null; then
            sed -i 's|^#DSHELL=.*|DSHELL=/usr/bin/zsh|' /etc/adduser.conf || true
        else
            printf '%s\n' 'DSHELL=/usr/bin/zsh' >> /etc/adduser.conf || true
        fi
    fi

    reset_ptyxis() {
        user=$1
        home=$2
        group=$3
        command -v dconf >/dev/null 2>&1 || return 0
        marker="$home/.config/tinhmenhdo-ubuntu/ptyxis-reset"
        [ -e "$marker" ] && return 0

        # Ptyxis stores profiles and palettes in dconf. Reset only once on
        # first installation; later package updates must keep user choices.
        if runuser -u "$user" -- env HOME="$home" \
            XDG_CONFIG_HOME="$home/.config" dconf reset -f /org/gnome/Ptyxis/ \
            >/dev/null 2>&1; then
            install -d -o "$user" -g "$group" -m 0755 \
                "$home/.config/tinhmenhdo-ubuntu" || true
            install -o "$user" -g "$group" -m 0644 /dev/null "$marker" || true
        fi
    }

    configure_user() {
        user=$1
        home=$2
        group=$(id -gn "$user" 2>/dev/null || true)
        [ -n "$group" ] || return 0

        reset_ptyxis "$user" "$home" "$group" || true

        # Preserve an existing configuration, but make sure it loads the
        # package configuration so history and the packaged Zsh plugins work.
        pkg_zshrc=/usr/share/tinhmenhdo-ubuntu/tinhmenhdo.zshrc
        if [ ! -f "$pkg_zshrc" ] && [ -f /usr/share/tinhmenhdo-ubuntu/zshrc ]; then
            pkg_zshrc=/usr/share/tinhmenhdo-ubuntu/zshrc
        fi

        if [ ! -e "$home/.zshrc" ]; then
            install -o "$user" -g "$group" -m 0644 \
                "$pkg_zshrc" "$home/.zshrc" || true
        else
            # Strip previous faulty marker blocks if any existed
            sed -i '/# >>> tinhmenhdo-ubuntu zsh configuration >>>/,/# <<< tinhmenhdo-ubuntu zsh configuration <<</d' "$home/.zshrc" 2>/dev/null || true
            {
                printf '\n%s\n' '# >>> tinhmenhdo-ubuntu zsh configuration >>>'
                printf '%s\n' "[ -r $pkg_zshrc ] && . $pkg_zshrc"
                printf '%s\n' '# <<< tinhmenhdo-ubuntu zsh configuration <<<'
            } >> "$home/.zshrc" || true
        fi

        # A failed network clone is deliberately retryable on the next
        # package configuration. It must never leave dpkg half-configured.
        if [ ! -r "$home/.oh-my-zsh/oh-my-zsh.sh" ] && command -v git >/dev/null 2>&1; then
            tmp_omz=$(runuser -u "$user" -- mktemp -d \
                "$home/.oh-my-zsh.XXXXXX" 2>/dev/null || true)
            if [ -n "$tmp_omz" ]; then
                if runuser -u "$user" -- git clone --depth=1 --quiet \
                    https://github.com/ohmyzsh/ohmyzsh.git "$tmp_omz/repo" \
                    >/dev/null 2>&1; then
                    if [ ! -e "$home/.oh-my-zsh" ]; then
                        mv "$tmp_omz/repo" "$home/.oh-my-zsh" || true
                    fi
                fi
                rm -rf "$tmp_omz" || true
            fi
        fi

        # usermod is non-interactive and safe to repeat.
        if command -v usermod >/dev/null 2>&1; then
            usermod -s /usr/bin/zsh "$user" >/dev/null 2>&1 || true
        fi

        # Configure SKey when its optional package is available. The command
        # is safe to repeat and failure remains retryable on reconfigure.
        if command -v skey-setup >/dev/null 2>&1; then
            runuser -u "$user" -- env HOME="$home" \
                XDG_CONFIG_HOME="$home/.config" skey-setup -y \
                >/dev/null 2>&1 || true
        fi
    }

    # Configure desktop users without replacing an existing .zshrc. A failure
    # for one user is isolated so later users and future dpkg retries proceed.
    while IFS=: read -r user _ uid _ _ home shell; do
        case "$uid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        [ "$uid" -lt 60000 ] 2>/dev/null || continue
        [ -d "$home" ] || continue
        [ "$home" != /nonexistent ] || continue
        case "$shell" in
            */false|*/nologin) continue ;;
        esac
        configure_user "$user" "$home" || true
    done <<EOF
$(getent passwd)
EOF
fi

# Enable installed system daemons without attempting account/authentication
# setup. These commands are safe to repeat and harmless in non-systemd builds.
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable tailscaled.service >/dev/null 2>&1 || true
    systemctl start tailscaled.service >/dev/null 2>&1 || true
    systemctl enable rustdesk.service >/dev/null 2>&1 || true
    systemctl start rustdesk.service >/dev/null 2>&1 || true
fi

exit 0
